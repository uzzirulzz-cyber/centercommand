# ============================================================================
# PlayBeat Digital — Central Admin.  Copy to `.env.local` and fill in.
# NEVER commit `.env.local`. All of these are read SERVER-SIDE ONLY; none are
# exposed to the browser (no NEXT_PUBLIC_ prefix anywhere).
# ============================================================================

# ---------- Connector mode -------------------------------------------------
# 'live' = call the real APIs. Any app without credentials stays 'pending'
#          and is shown with NO metrics (never fabricated).
# 'demo' = use the clearly-labelled fixture dataset in lib/data.js.
PB_CONNECTOR_MODE=live

# ---------- Session / auth -------------------------------------------------
# 32+ random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
PB_SESSION_SECRET=
PB_CSRF_SECRET=
# Session policy (defaults shown)
PB_SESSION_IDLE_MINUTES=30
PB_SESSION_ABSOLUTE_HOURS=8
# Password hashing (bcrypt cost). 12 is a sane production floor.
BCRYPT_ROUNDS=12
# Where server-side session + audit + sync state is written.
# Local development fallback only. Vercel production must set DATABASE_URL or
# POSTGRES_URL and run `npm run db:migrate` before serving traffic.
PB_DATA_DIR=./data
DATABASE_URL=

# ---------- Bootstrap admin ------------------------------------------------
# Used once by `npm run seed:admin` to create the first account, then remove.
ADMIN_EMAIL=admin@playbeat.digital
ADMIN_PASSWORD=
# Optional: 32-char base32 TOTP secret to require MFA for this account.
ADMIN_TOTP_SECRET=

# ---------- Per-application connectors ------------------------------------
# PlayBeat.digital
PLAYBEAT_DIGITAL_API_URL=
PLAYBEAT_DIGITAL_API_KEY=

# PlayBeat.live
PLAYBEAT_LIVE_API_URL=
PLAYBEAT_LIVE_API_KEY=
# Read-only server-side dashboard bridge from PlayBeat Digital. Optional;
# the admin will show integration limits until this token is configured.
LIVE_DASHBOARD_TOKEN=

# MagXTV.click
MAGXTV_API_URL=
MAGXTV_API_KEY=

# MakeThisDeal.biz
MAKETHISDEAL_API_URL=
MAKETHISDEAL_API_KEY=

# Pulse CRM (uzzirulzz-cyber/eaedpulseplus)
PULSE_CRM_REPO=uzzirulzz-cyber/eaedpulseplus
PULSE_CRM_API_URL=
PULSE_CRM_API_KEY=

# ---------- Connector resilience ------------------------------------------
CONNECTOR_TIMEOUT_MS=8000
CONNECTOR_MAX_RETRIES=3
CONNECTOR_RATE_LIMIT=120
CONNECTOR_BREAKER_THRESHOLD=5
CONNECTOR_BREAKER_COOLDOWN_MS=60000

# ---------- Meta / WhatsApp (see README §9) -------------------------------
# REQUIRED, no default: pick the version you have tested against from
# https://developers.facebook.com/docs/graph-api/changelog/versions/
META_APP_ID=
META_OAUTH_REDIRECT_URI=https://playbeatarena.asia/api/auth/meta/callback
# 32-byte encryption key, encoded as 64 hex chars or base64. Generate locally
# (for example: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))")
# Store only in Vercel Environment Variables; never commit the generated value.
META_TOKEN_ENCRYPTION_KEY=
META_GRAPH_VERSION=
META_WABA_TOKEN=
META_PHONE_NUMBER_ID=
# Webhook signature verification (HMAC-SHA256 of the RAW body).
META_FB_APP_SECRET=
# The token you type into Meta's webhook setup form; echoed back on the GET handshake.
META_WEBHOOK_VERIFY_TOKEN=

# =============================================================================
# Per-application contract values (names only — read from each app's own repo).
# Fill these in your deployment environment; never commit real values.
# Full endpoint map: docs/INTEGRATION-CONTRACTS.md and lib/appContracts.js
# =============================================================================

# ---- PlayBeat.digital (repo: uzzirulzz-cyber/izoko) -------------------------
# Connector base points at the app's own admin API (needs an admin JWT bearer).
PLAYBEAT_DIGITAL_API_URL=""        # https://playbeat.digital/api/admin
PLAYBEAT_DIGITAL_API_KEY=""        # admin JWT (7-day TTL) from POST /api/auth/admin/login
PLAYBEAT_DIGITAL_ORIGIN=""         # https://playbeat.digital  (webhook: /webhooks/rapid-gateway)
PB_DIGITAL_PUBLIC_SITE_URL=""      # PUBLIC_SITE_URL
PB_DIGITAL_GA4_ID=""               # GA4_MEASUREMENT_ID  (e.g. G-XXXXXXXXXX)
PB_DIGITAL_GTM_ID=""               # GTM_CONTAINER_ID
PB_DIGITAL_ADSENSE_CLIENT_ID=""    # ADSENSE_CLIENT_ID  (ca-pub-…)

# ---- Rapid Gateway (payments — DB-backed + encrypted at rest in the app) ---
RAPID_SECRET_KEY=""                # server-side ONLY; never rendered in the admin UI
RAPID_API_BASE=""                  # https://api.rapidgateway.pk
RAPID_METHODS=""                   # easypaisa,jazzcash,card
RAPID_WEBHOOK_SECRET=""            # salt mirrored from the Rapid portal
RAPID_WEBHOOK_SECRET_PREVIOUS=""   # optional, during rotation

# ---- PlayBeat.live (repos: playbeat.live / livetv / playbeattv) -------------
PLAYBEAT_LIVE_API_URL=""           # https://playbeat.live
PLAYBEAT_LIVE_API_KEY=""           # ADMIN_TOKEN of the live app
LIVE_DASHBOARD_ORIGIN=""           # https://playbeat-storefront.crdbixx.workers.dev
LIVE_DASHBOARD_TOKEN=""            # bearer token for /api/digital-dashboard
PB_LIVE_GA4_PROPERTY_ID=""         # GA4 property for the live hostnames

# ---- MagXTV.click (repo: uzzirulzz-cyber/magxtv.click — PRIVATE) -----------
MAGXTV_API_URL=""
MAGXTV_API_KEY=""

# ---- MakeThisDeal.biz (repo not yet identified — confirm: vbn / playbeat-crm-platform)
MAKETHISDEAL_API_URL=""
MAKETHISDEAL_API_KEY=""

# ---- PlayBeat Pulse CRM (repo: uzzirulzz-cyber/eaedpulseplus — PRIVATE) ----
PULSE_CRM_REPO="uzzirulzz-cyber/eaedpulseplus"
PULSE_CRM_API_URL=""
PULSE_CRM_API_KEY=""

# ---- Mobile / Android admin (izoko: mobile/, android/, MOBILE_API.md) ------
PB_MOBILE_API_BASE=""              # https://playbeat.digital  (same backend + same customer DB)
PB_ANDROID_PACKAGE_NAME=""         # digital.playbeat.app
PB_ANDROID_APP_URL=""              # empty = honest "Pending deployment"
PB_IOS_BUNDLE_ID=""                # digital.playbeat.app
PB_IOS_APP_URL=""                  # empty = not live

# ---------------------------------------------------------------------------
# Live connectors (PlayBeat central administration)
# Each connected application needs a base URL and a key. Until BOTH exist and a
# real authenticated health check succeeds, the application is shown as
# "Not configured" and contributes NO metrics — no placeholder numbers.
# ---------------------------------------------------------------------------
# PlayBeat Digital (storefront, products, orders, customers, subscriptions, payments)
PLAYBEAT_DIGITAL_API_URL=
PLAYBEAT_DIGITAL_API_KEY=
# PlayBeat Live (entertainment, live channels, playlists, playback health, audience)
PLAYBEAT_LIVE_API_URL=
PLAYBEAT_LIVE_API_KEY=
# MagXTV (sports broadcasting: matches, schedules, results, highlights, stats; betting stays disabled)
MAGXTV_API_URL=
MAGXTV_API_KEY=
# MakeThisDeal (listings, leads, enquiries, transactions)
MAKETHISDEAL_API_URL=
MAKETHISDEAL_API_KEY=
# PlayBeat Pulse CRM (uzzirulzz-cyber/eaedpulseplus — leads, seats, pipeline)
PULSE_CRM_API_URL=
PULSE_CRM_API_KEY=
